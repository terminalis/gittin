[Desktop Entry]
Type=Application
Name=Gittin
Comment=Write Markdown, notes, code and config files
Exec=gittin %F
Icon=io.github.terminalis.Gittin
Terminal=false
Categories=Utility;TextEditor;
Keywords=markdown;notes;editor;text;yaml;json;
MimeType=text/markdown;text/plain;text/javascript;application/json;text/html;text/css;application/yaml;video/mp2t;text/vnd.trolltech.linguist;
StartupNotify=true
