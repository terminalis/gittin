{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Gittin's window: its file dialogs, and reading and writing what is picked in them.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat"
  ]
}
